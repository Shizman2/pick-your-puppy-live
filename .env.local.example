# Copy this file to .env.local and fill in your real values.
# .env.local should never be committed or shared - it's for your machine only.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (or service_role key) - server-side only, never exposed to the browser.
# Do not add a NEXT_PUBLIC_ prefix to this one.
SUPABASE_SECRET_KEY=

# Web Push VAPID keys - generate with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is safe to expose to the browser (NEXT_PUBLIC_ prefix required
# so the admin Notification Settings page can read it). The private key must
# never be exposed client-side - do not add a NEXT_PUBLIC_ prefix to it.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact email Web Push services may use to reach you about this app.
VAPID_CONTACT_EMAIL=
